Encapsualtion//in java....

import java.util.*;
class Animal{
    private String name;
    private int age;
    void setName(String name){
        this.name=name;
    }
    void setAge(int age){
        this.age=age;
    }
    String getName(){
        return name;
    }
    int getAge(){
        return age;
    }
}
class Main {
    public static void main(String[] args) {
        Animal a=new Animal();
        a.setName("Vignesh");
        a.setAge(56);
        System.out.println(a.getName());
        System.out.println(a.getAge());
    }
}
