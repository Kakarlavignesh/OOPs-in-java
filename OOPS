Method overloading...
import java.util.*;
class Vignesh{
    public void add(int n,int m){
        System.out.println(n+m);
    }
    public void add(int n,int m,int l){
        System.out.println(n+m+l);
    }
}
class Main {
    public static void main(String[] args) {
        Vignesh nasa=new Vignesh();
        nasa.add(4,5);
        nasa.add(8,9,7);
    }
}
Method overriding..
import java.util.*;
class Student{
    public void add(int m,int n){
        System.out.print(n+m);
    }
}
class vignesh extends Student{
    @Override
    public void add(int m,int n){
    System.out.print(n+m);
    }
}
class Main {
    public static void main(String[] args) {
        Student s=new Student();
        s.add(9,8);
    }
}

import java.util.*;
class Main {
    public static boolean isPrime(int a){
        // int a=43;
        int count=0;
        for(int i=2;i<a;i++){
            if(a%i==0){
                return false;
            }
        }
        return true;
    }
    public static void main(String[] args) {
        System.out.println(isPrime(42));
    }
}

Multiple inheritance...

import java.util.*;
interface Animal{
    public void Dog();
}
interface Birds{
    public void Fly();
}
class Humans implements Animal,Birds{
    @Override
    public void Dog(){
        System.out.println("Dog barks");
    }
    @Override
    public void Fly(){
        System.out.println("Birds Fly");
    }
    public void Runs(){
        System.out.println("Human walks");
    }
}
class Main {
    public static void main(String[] args) {
        Humans h=new Humans();
        h.Dog();
        h.Fly();
        h.Runs();
    }
}
